# انسخي الملف ده باسم .env وعدّلي القيم. متحطيش هنا Secrets أو AWS keys.
# true = Demo mode (بيانات تجريبية). خليها false لما الـ Backend يجهز.
VITE_USE_MOCK=true
VITE_API_URL=http://localhost:8000
# Google login (Cognito Hosted UI): القيم من مسؤول الـ Backend
VITE_COGNITO_DOMAIN=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_REDIRECT_URI=http://localhost:5173/auth/callback
